# ============================================
# CopyCraft SaaS — Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit the .env file to version control!

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- JWT Authentication ----
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ---- Database (MongoDB Atlas) ----
DB_NAME=copycraft_db
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/copycraft_db?retryWrites=true&w=majority

# ---- CORS ----
# Comma-separated. Add your Vercel URL alongside localhost for production:
# CORS_ORIGIN=https://copycraft-nine.vercel.app,http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---- Frontend (Vite) ----
# Set this in Vercel's project environment variables (not committed to git)
# No trailing slash. Leave blank for local dev (Vite proxy handles it).
VITE_API_URL=


# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@copycraft.com

# ---- File Uploads ----
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# ---- Admin Seeded Credentials ----
ADMIN_DEFAULT_EMAIL=admin@copycraft.com
ADMIN_DEFAULT_PASSWORD=

# ---- Pricing Defaults (₹ per page) ----
DEFAULT_BW_RATE=1.50
DEFAULT_COLOR_RATE=6.00
DEFAULT_SPIRAL_BINDING_RATE=35
DEFAULT_SOFTCOVER_RATE=65
DEFAULT_HARDCOVER_RATE=130

# ---- Session / Security ----
BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Logging ----
LOG_LEVEL=debug

# ---- Cloudflare R2 Object Storage ----
# Sign up at https://dash.cloudflare.com → R2 → Create bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=copycraft-files
R2_PUBLIC_URL=
